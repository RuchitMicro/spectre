# Local environment for {{project_name}}.
# This file is gitignored. Commit changes to .env.example instead.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG                   = True

# Generated per project at scaffold time. Rotate before going to production.
SECRET_KEY              = '{{secret_key}}'

# Comma separated. Only applied when DEBUG is False; development allows any host.
ALLOWED_HOSTS           = localhost,127.0.0.1

# Public URL of the frontend. Password reset links are built from this.
FRONTEND_URL            = http://localhost:3000

# Comma separated browser origins allowed to call this API in production.
CORS_ALLOWED_ORIGINS    =

# ---------------------------------------------------------------------------
# Database
# Leave DB_NAME empty to use SQLite. Set it to switch to PostgreSQL.
# ---------------------------------------------------------------------------
DB_NAME                 =
DB_USER                 = postgres
DB_PASSWORD             = postgres
DB_HOST                 = 127.0.0.1
DB_PORT                 = 5432

# ---------------------------------------------------------------------------
# Cache
# Leave empty to use a per-process cache with no external service.
# ---------------------------------------------------------------------------
REDIS_URL               =

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_HOST              =
EMAIL_HOST_USER         =
EMAIL_HOST_PASSWORD     =
