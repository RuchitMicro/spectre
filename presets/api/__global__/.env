# Local environment for {{project_name}}.
# This file is gitignored. Commit changes to .env.example instead.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG                   = True

# Generated per project at scaffold time. Rotate before going to production.
SECRET_KEY              = '{{secret_key}}'

# Comma separated. Only applied when DEBUG is False; development allows any host.
ALLOWED_HOSTS           = localhost,127.0.0.1

# Public URL of the frontend. Password reset links are built from this.
FRONTEND_URL            = http://localhost:3000

# Comma separated browser origins allowed to call this API in production.
CORS_ALLOWED_ORIGINS    =

# ---------------------------------------------------------------------------
# Database
# Leave DB_NAME empty to use SQLite. Set it to switch to PostgreSQL.
# ---------------------------------------------------------------------------
DB_NAME                 =
DB_USER                 = postgres
DB_PASSWORD             = postgres
DB_HOST                 = 127.0.0.1
DB_PORT                 = 5432

# ---------------------------------------------------------------------------
# Cache
# Leave empty to use a per-process cache with no external service.
# ---------------------------------------------------------------------------
REDIS_URL               =

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_HOST              =
EMAIL_HOST_USER         =
EMAIL_HOST_PASSWORD     =

# ---------------------------------------------------------------------------
# Logging  (see {{project_name}}/logging_config.py)
# ---------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL               = INFO

# text = human readable. json = one JSON object per line, which is what a log
# shipper (Promtail/Alloy into Loki) parses. Use json in production.
LOG_FORMAT              = text

# False logs only to stdout, which is what you want in a container.
LOG_TO_FILE             = True

# Where the log files go. Defaults to <project>/logs.
LOG_DIR                 =

# True logs every SQL query with timing. Verbose: for chasing an N+1, not daily use.
SQL_DEBUG               = False

# Comma separated. Emailed on unhandled 500s once DEBUG is False.
ADMIN_EMAILS            =
