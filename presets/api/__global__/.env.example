# Template for .env. Copy to .env and fill in real values.
#   cp .env.example .env
#
# Generate a fresh SECRET_KEY:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG                   = True
SECRET_KEY              =
ALLOWED_HOSTS           = localhost,127.0.0.1
FRONTEND_URL            = http://localhost:3000
CORS_ALLOWED_ORIGINS    =

# ---------------------------------------------------------------------------
# Database (leave DB_NAME empty for SQLite)
# ---------------------------------------------------------------------------
DB_NAME                 =
DB_USER                 = postgres
DB_PASSWORD             = postgres
DB_HOST                 = 127.0.0.1
DB_PORT                 = 5432

# ---------------------------------------------------------------------------
# Cache (leave empty for an in-process cache)
# ---------------------------------------------------------------------------
REDIS_URL               =

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_HOST              =
EMAIL_HOST_USER         =
EMAIL_HOST_PASSWORD     =

# ---------------------------------------------------------------------------
# Logging  (see {{project_name}}/logging_config.py)
# ---------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL               = INFO

# text = human readable. json = one JSON object per line, which is what a log
# shipper (Promtail/Alloy into Loki) parses. Use json in production.
LOG_FORMAT              = text

# False logs only to stdout, which is what you want in a container.
LOG_TO_FILE             = True

# Where the log files go. Defaults to <project>/logs.
LOG_DIR                 =

# True logs every SQL query with timing. Verbose: for chasing an N+1, not daily use.
SQL_DEBUG               = False

# Comma separated. Emailed on unhandled 500s once DEBUG is False.
ADMIN_EMAILS            =
