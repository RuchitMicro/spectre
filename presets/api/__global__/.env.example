# Template for .env. Copy to .env and fill in real values.
#   cp .env.example .env
#
# Generate a fresh SECRET_KEY:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DEBUG                   = True
SECRET_KEY              =
ALLOWED_HOSTS           = localhost,127.0.0.1
FRONTEND_URL            = http://localhost:3000
CORS_ALLOWED_ORIGINS    =

# ---------------------------------------------------------------------------
# Database (leave DB_NAME empty for SQLite)
# ---------------------------------------------------------------------------
DB_NAME                 =
DB_USER                 = postgres
DB_PASSWORD             = postgres
DB_HOST                 = 127.0.0.1
DB_PORT                 = 5432

# ---------------------------------------------------------------------------
# Cache (leave empty for an in-process cache)
# ---------------------------------------------------------------------------
REDIS_URL               =

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_HOST              =
EMAIL_HOST_USER         =
EMAIL_HOST_PASSWORD     =
